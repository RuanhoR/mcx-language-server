{
  "name": "mcx-language-plugin",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "engines": {
    "node": ">=22.13"
  },
  "main": "index.js",
  "scripts": {
    "prepare": "simple-git-hooks",
    "lint:packages": "eslint . --ext .js,.ts",
    "lint:packages:fix": "eslint . --ext .js,.ts --fix",
    "format": "prettier \"./packages/**/src/**/*.ts\" \"./packages/**/__test__/**/*.ts\" \"./extensions/**/src/**/*.ts\" \"./eslint.config.js\" \"./vitest.config.ts\" --write",
    "test": "vitest run",
    "build": "pnpm -r build",
    "build:ext": "pnpm --filter @mbler/mcx-server build:ext && pnpm --filter @mbler/mcx-ts-plugin build:ext && pnpm --filter mcx-vscode-client build",
    "build:all": "pnpm build && pnpm build:ext",
    "check": "pnpm test && pnpm lint:packages && pnpm -r type-check"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@11.8.0",
  "workspaces": [
    "packages/server",
    "packages/ts-plugin"
  ],
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^25.9.3",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.17.0",
    "picocolors": "^1.1.1",
    "prettier": "3.8.3",
    "rolldown": "1.1.1",
    "simple-git-hooks": "^2.13.1",
    "tslib": "^2.8.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.8"
  },
  "simple-git-hooks": {
    "config": ".simple-git-hooks.mjs"
  },
  "dependencies": {
    "rolldown-plugin-dts": "^0.25.2"
  }
}
