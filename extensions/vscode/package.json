{
  "name": "mcx-vscode-client",
  "version": "1.1.7",
  "description": "Language support for MCX language.",
  "publisher": "ruanhor",
  "license": "MIT",
  "author": {
    "url": "https://github.com/RuanhoR",
    "name": "ruanhor",
    "email": "root@ruanhor.dpdns.org"
  },
  "engines": {
    "vscode": "^1.115.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage",
    "onStartupFinished"
  ],
  "repository": {
    "url": "https://github.com/RuanhoR/mcx-language-server"
  },
  "main": "dist/extension.js",
  "types": "dist/extension.d.ts",
  "scripts": {
    "build": "rolldown -c",
    "pack": "npx @vscode/vsce package --allow-star-activation",
    "test": "pnpm build && cd test && pnpm test",
    "type-check": "tsc --noEmit",
    "check": "pnpm type-check && pnpm test"
  },
  "displayName": "MCX Language",
  "contributes": {
    "commands": [
      {
        "command": "mcx.restart.language",
        "title": "%mcx.restart.language%",
        "category": "MCX"
      },
      {
        "command": "mcx.action.welcome",
        "title": "%mcx.action.welcome%",
        "category": "MCX"
      }
    ],
    "languages": [
      {
        "id": "mcx",
        "aliases": [
          "MCX",
          "mcx"
        ],
        "extensions": [
          ".mcx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mcx",
        "scopeName": "text.mcx",
        "path": "./syntaxes/mcx.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.script.ts.mcx": "typescript",
          "meta.embedded.block.script.js.mcx": "javascript"
        }
      }
    ],
    "typescriptServerPlugins": [
      {
        "name": "mcx-typescript-plugin-pack",
        "enableForWorkspaceTypeScriptVersions": true
      }
    ],
    "configuration": {
      "title": "MCX",
      "properties": {
        "mcx.welcome.show": {
          "type": "boolean",
          "default": true,
          "description": "Show the welcome page when the extension is installed or updated."
        },
        "mcx.lint.enable": {
          "type": "boolean",
          "default": true,
          "description": "Lint .mcx files with the @mbler/eslint-plugin-mcx rules (duplicate root tags, unknown world events, invalid JSON prop values, missing <script lang>)."
        },
        "mcx.lint.allowUnknownEvents": {
          "type": "boolean",
          "default": false,
          "description": "Accept any <Event> key instead of validating it against the @minecraft/server typings installed in the project. Turn this on if you bind events your typings do not declare."
        }
      }
    }
  },
  "devDependencies": {
    "@mbler/eslint-plugin-mcx": "0.0.1-rc.1",
    "@mbler/mcx-core": "1.1.5-rc.4",
    "@mbler/mcx-server": "workspace:*",
    "@mbler/mcx-ts-plugin": "workspace:*",
    "@types/vscode": "^1.115.0",
    "@volar/vscode": "^2.4.28",
    "@vscode/vsce": "^3.9.1",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vscode-languageclient": "^9.0.1"
  }
}
