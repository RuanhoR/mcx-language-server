{
  "name": "mcx-vscode-client",
  "version": "1.0.1",
  "description": "Lanuage support for MCX language.",
  "publisher": "ruanhor",
  "license": "MIT",
  "author": {
    "url": "https://github.com/RuanhoR",
    "name": "ruanhor",
    "email": "root@ruanhor.dpdns.org"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:mcx"
  ],
  "repository": {
    "url": "https://github.com/RuanhoR/mcx-language-server"
  },
  "main": "dist/extension.js",
  "types": "dist/extension.d.ts",
  "files": [
    "dist",
    "node_modules",
    "language-configuration.json",
    "syntaxes/mcx.tmLanguage.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c",
    "pack": "vsce package --allow-unused-files-pattern",
    "test": "pnpm build && cd test && pnpm test"
  },
  "displayName": "MCX Language",
  "contributes": {
    "commands": [
      {
        "command": "mcx.restart.language",
        "title": "MCX: Restart Lanuage Server",
        "category": "MCX"
      }
    ],
    "languages": [
      {
        "id": "mcx",
        "aliases": [
          "MCX",
          "mcx"
        ],
        "extensions": [
          ".mcx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mcx",
        "scopeName": "text.mcx",
        "path": "./syntaxes/mcx.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.script.ts.mcx": "typescript",
          "meta.embedded.block.script.js.mcx": "javascript"
        }
      }
    ],
    "typescriptServerPlugins": [
      {
        "name": "@mbler/mcx-ts-plugin",
        "enableForWorkspaceTypeScriptVersions": true
      }
    ]
  },
  "dependencies": {
    "@mbler/mcx-core": "^0.0.5",
    "@mbler/mcx-server": "0.1.1-beta.r20260508.1",
    "@mbler/mcx-ts-plugin": "0.1.1-alpha.r20260420.1",
    "@types/vscode": "^1.115.0",
    "@volar/vscode": "^2.4.28",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.1"
  }
}
