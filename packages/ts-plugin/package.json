{
  "name": "@mbler/mcx-ts-plugin",
  "version": "0.1.2-rc.3",
  "description": "TypeScript server plugin for MCX",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "author": "ruanhor",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:ext": "rolldown -c rolldown.ext.config.mjs",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@mbler/mcx-server": "workspace:*",
    "@volar/typescript": "^2.4.28"
  },
  "devDependencies": {
    "rolldown": "1.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
