{
  "compilerOptions": {
    "module": "preserve",
    "target": "es2024",
    "moduleResolution": "bundler",
    "noEmit": false,
    "strict": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "skipLibCheck": true,
    "allowJs": true,
    "esModuleInterop": true
  },
  "include": [
    "src/**/*.ts"
  ]
}