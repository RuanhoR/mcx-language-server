{
  "name": "@mbler/mcx-server",
  "version": "0.1.4",
  "description": "MCX Language Server",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.8.0",
  "license": "MIT",
  "author": {
    "email": "root@ruanhor.dpdns.org",
    "name": "ruanhor",
    "url": "https://github.com/RuanhoR"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rolldown -c",
    "build:ext": "rolldown -c rolldown.ext.config.mjs",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/parser": "^7.24.0",
    "@mbler/mcx": "0.0.5",
    "@mbler/mcx-core": "0.1.3-rc.14",
    "@mbler/mcx-types": "^0.0.4-rc.7",
    "@volar/language-core": "^2.4.28",
    "@volar/language-server": "^2.4.28",
    "typescript": "5.9.3",
    "volar-service-typescript": "^0.0.70",
    "vscode-languageserver": "^9.0.1"
  },
  "bin": {
    "mcx-language-server": "bin/mcx-server.js"
  }
}
